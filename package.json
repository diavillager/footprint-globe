{
  "name": "footprint-globe",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "audit:build": "tsc --noEmit && vite build --config vite.audit.config.mts",
    "audit:preview": "vite preview --config vite.audit.config.mts --host 127.0.0.1 --port 4190",
    "test": "npm run test:sample && npm run test:app",
    "test:sample": "node --test tests/timeline-sample.test.cjs tests/structure-diagnostics.test.cjs tests/raw-signals.test.cjs tests/source-audit.test.cjs",
    "test:app": "vitest run",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "maplibre-gl": "6.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-globe.gl": "2.38.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "topojson-client": "3.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "world-atlas": "2.0.2"
  }
}
